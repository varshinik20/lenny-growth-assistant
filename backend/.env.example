APP_NAME=Lenny Growth Assistant
APP_VERSION=1.0.0

# Database Connection (PostgreSQL or SQLite e.g., sqlite:///./lenny.db)
DATABASE_URL=postgresql://user:password@localhost:5432/lenny_db

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Optional Cloud LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
